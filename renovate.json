{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["customManagers:githubActionsVersions"],
  "addLabels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update built-in Kubara Catalog OCI references",
      "managerFilePatterns": [
        "/^src\\/internal\\/catalog\\/bootstrap\\.go$/",
        "/^docs\\/content\\/.*\\.md$/"
      ],
      "matchStrings": [
        "oci://(?<depName>ghcr\\.io/kubara-io/catalogs/(bootstrap|general)):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update annotated dependency versions in Go constants",
      "managerFilePatterns": ["/\\.go$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+(?:const\\s+)?\\w+\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Update the compatible bootstrap and general catalogs together",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/kubara-io/catalogs/bootstrap",
        "ghcr.io/kubara-io/catalogs/general"
      ],
      "groupName": "Kubara catalogs",
      "groupSlug": "kubara-catalogs"
    },
    {
      "description": "Run go mod tidy for all go module updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Group go module updates (minor and patch)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules (minor and patch)",
      "groupSlug": "gomod-minor-patch"
    },
    {
      "description": "Group go module updates (major)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go modules (major)",
      "groupSlug": "gomod-major"
    },
    {
      "description": "Group GitHub Actions updates (minor and patch)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions (minor and patch)",
      "groupSlug": "github-actions-minor-patch"
    },
    {
      "description": "Group GitHub Actions updates (major)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)",
      "groupSlug": "github-actions-major"
    }
  ]
}
